{
  "name": "sip-app",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build:react-jssip-kit": "npm run build --workspace=react-jssip-kit",
    "dev:demo": "npm run dev --workspace=demo",
    "build:demo": "npm run build --workspace=demo",
    "build": "npm run build:react-jssip-kit && npm run build:demo",
    "test": "npm run test --workspace=react-jssip-kit",
    "test:coverage": "npm run test:coverage --workspace=react-jssip-kit",
    "release:check": "npm run lint --workspace=react-jssip-kit && npm run typecheck --workspace=react-jssip-kit && npm run test:coverage --workspace=react-jssip-kit && npm run build --workspace=react-jssip-kit && npm pack --dry-run --workspace=react-jssip-kit",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "private": true,
  "workspaces": [
    "react-jssip-kit",
    "demo"
  ],
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0"
  },
  "lint-staged": {
    "react-jssip-kit/src/**/*.{ts,tsx}": [
      "prettier --write",
      "npm exec --workspace=react-jssip-kit eslint -- --fix"
    ],
    "react-jssip-kit/*.{ts,json,md}": "prettier --write"
  }
}
